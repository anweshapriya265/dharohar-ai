# Dharohar AI - Root gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
backend/.venv/
env/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
coverage/

# Node
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
*.log

# Environment & Secrets
.env
.env.local
.env.*.local
frontend/.env.local

# Storage / Artifacts / SQLite
backend/storage/
backend/data/*.db*
backend/data/*.sqlite*
backend/data/uploads/*
!backend/data/uploads/.gitkeep
*.db
*.db-wal
*.db-shm
.DS_Store
Thumbs.db

# Large test datasets
test_dataset/*.pdf
test_dataset/samples/*.pdf
